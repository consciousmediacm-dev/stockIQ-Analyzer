# Copy to .env (never commit .env). Every key is optional.

# ── Market data ────────────────────────────────────────────────
# Yahoo Finance is used by default (no key). Alpha Vantage is the failover
# and the source for the all-US ticker universe.
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_PREMIUM=false        # true on a paid plan (split-adjusted history, higher limits)

# ── AI Outlook providers ───────────────────────────────────────
GROQ_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# STOCKIQ_MODEL_ANTHROPIC=claude-opus-5-5   # override any provider's model ID

# ── Runtime ────────────────────────────────────────────────────
STOCKIQ_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
STOCKIQ_DATA_DIR=                  # default ~/.stockiq — caches, forecast log, backtest prices
STOCKIQ_CACHE_BACKEND=memory       # memory | sqlite (sqlite survives restarts)
SCREENER_TICKER_COUNT=300          # scan fewer tickers while developing
